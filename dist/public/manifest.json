{
  "name": "RetroArch Web - Retro Gaming Platform",
  "short_name": "RetroArch Web",
  "description": "Play classic retro games in your browser with support for NES, SNES, Game Boy, and more",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0f0f14",
  "theme_color": "#a855f7",
  "orientation": "any",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": ["games", "entertainment"],
  "screenshots": [],
  "share_target": {
    "action": "/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "rom",
          "accept": [".nes", ".smc", ".sfc", ".gb", ".gbc", ".gba", ".bin", ".md", ".gen", ".z64", ".n64", ".iso"]
        }
      ]
    }
  }
}
